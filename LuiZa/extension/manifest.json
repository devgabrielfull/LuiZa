{
  "manifest_version": 3,
  "name": "LuiZa",
  "version": "1.0.0",
  "description": "Transcreva vídeos do YouTube localmente com a API Whisper",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:3333"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
